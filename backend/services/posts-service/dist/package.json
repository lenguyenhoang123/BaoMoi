{
    "name": "posts-service",
    "version": "1.0.0",
    "description": "Posts service for Bao Moi application",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "set NODE_OPTIONS=--no-warnings && ts-node-dev --respawn --transpile-only --no-notify src/server.ts",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint . --ext .ts",
        "migrate": "ts-node src/migrations/migrate.ts"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "dependencies": {
        "@types/body-parser": "^1.19.6",
        "@types/swagger-jsdoc": "^6.0.4",
        "axios": "^1.6.7",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.9.0",
        "helmet": "^7.1.0",
        "joi": "^17.13.3",
        "knex": "^3.1.0",
        "multer": "^2.0.1",
        "pg": "^8.11.3",
        "socket.io": "^4.7.4",
        "sqlite3": "^5.1.7",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.ts"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json"
        ],
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "testTimeout": 30000
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/dotenv": "^8.2.0",
        "@types/express": "^4.17.21",
        "@types/helmet": "^4.0.0",
        "@types/jest": "^29.5.11",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.13",
        "@types/node": "^18.19.37",
        "@types/pg": "^8.15.4",
        "@types/socket.io": "^3.0.2",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "~4.9.5",
        "yamljs": "^0.3.0"
    }
}
