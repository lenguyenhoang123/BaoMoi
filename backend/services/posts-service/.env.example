# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=posts_service

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# Categories Service
CATEGORY_SERVICE_URL=http://localhost:3002

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=5m
LOG_MAX_FILES=5

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 phút
RATE_LIMIT_MAX_REQUESTS=100  # Số request tối đa trong 1 cửa sổ thời gian
