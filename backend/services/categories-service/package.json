{
  "name": "categories-service",
  "version": "1.0.0",
  "description": "Categories Service for Bao Moi",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "nodemon --exec node --import tsx src/server.ts",
    "build": "tsc && cp -r src/views dist/ && cp -r src/public dist/",
    "test": "NODE_OPTIONS='--import=tsx' jest",
    "test:watch": "NODE_OPTIONS='--import=tsx' jest --watch",
    "test:ci": "NODE_OPTIONS='--import=tsx' jest --ci --coverage",
    "db:migrate": "npx sequelize-cli db:migrate --config=./sequelize.config.js",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo --config=./sequelize.config.js",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all --config=./sequelize.config.js",
    "db:seed": "npx sequelize-cli db:seed:all --config=./sequelize.config.js",
    "db:create": "npx sequelize-cli db:create --config=./sequelize.config.js",
    "db:drop": "npx sequelize-cli db:drop --config=./sequelize.config.js",
    "typeorm": "node --import tsx ./node_modules/typeorm/cli.js",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.0.0",
    "http-status-codes": "^2.2.0",
    "morgan": "^1.10.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^11.1.0",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.52",
    "@types/pg": "^8.11.5",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.16",
    "@types/validator": "^13.15.1",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "sequelize-cli": "^6.6.3",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
