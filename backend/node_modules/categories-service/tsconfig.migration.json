{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist-migrations",
    "rootDir": "."
  },
  "include": [
    "migrations/**/*.ts",
    "src/models/**/*.ts"
  ]
}
