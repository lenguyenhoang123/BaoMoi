# Server Configuration
PORT=3009
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=categories_db
DB_USER=postgres
DB_PASSWORD=123
DB_SSL=false
DB_MAX_POOL=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_123
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3004
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3009
