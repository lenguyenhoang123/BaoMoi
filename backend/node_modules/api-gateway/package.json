{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for Bao Moi React",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "set NODE_OPTIONS=--no-warnings && tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/node": "^20.0.0",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^1.3.1",
    "morgan": "^1.10.0",
    "tslib": "^2.6.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.23",
    "@types/http-errors": "^2.0.5",
    "@types/http-proxy": "^1.17.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.0",
    "@types/send": "^0.17.5",
    "@types/serve-static": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
