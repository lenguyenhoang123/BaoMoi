# App Settings
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3004,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3006,http://localhost:3008,http://localhost:3009,http://localhost:8080,https://localhost:3000,https://localhost:3004,*

# API Gateway
API_GATEWAY_PORT=3000

# Auth Service
AUTH_SERVICE_PORT=3003

# User Service
USER_SERVICE_PORT=3001

# Posts Service
POSTS_SERVICE_PORT=3002

# Tags Service
TAGS_SERVICE_PORT=3006

# Categories Service
CATEGORIES_SERVICE_PORT=3009

# Comments Service
COMMENTS_SERVICE_PORT=3008

# Database Configuration
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tags_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
