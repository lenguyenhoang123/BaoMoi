'use client';

import { useState, useEffect, useCallback } from 'react';
import { useRouter } from 'next/navigation';
import { 
  Table, 
  Button, 
  Space, 
  Tag, 
  message, 
  Input, 
  Select, 
  Popconfirm,
  Card,
  Typography,
  TableProps,
  TablePaginationConfig
} from 'antd';
import { 
  SearchOutlined, 
  EditOutlined, 
  DeleteOutlined
} from '@ant-design/icons';
import type { FilterValue, SorterResult, ColumnsType } from 'antd/es/table/interface';
import Link from 'next/link';
import pagination from 'antd/es/pagination';
import React from 'react';

const { Search } = Input;
const { Option } = Select;
const { Title } = Typography;

// Define PostStatus as a constant object that can be used as both type and value
export const POST_STATUS = {
  DRAFT: 'DRAFT',
  PUBLISHED: 'PUBLISHED',
  ARCHIVED: 'ARCHIVED',
  PENDING: 'PENDING',
  REJECTED: 'REJECTED'
} as const;

type PostStatus = typeof POST_STATUS[keyof typeof POST_STATUS];

// Define types
interface Author {
  id: string;
  full_name: string;
  email: string;
  avatar?: string;
}

interface Category {
  id: string;
  name: string;
  slug: string;
  description?: string;
}

interface Post {
  id: string;
  title: string;
  slug: string;
  excerpt?: string;
  content: string;
  featured_image?: string;
  status: PostStatus;
  views: number;
  likes: number;
  created_at: string;
  updated_at: string;
  published_at?: string;
  author: Author;
  category: Category;
  tags?: Array<{ id: string; name: string }>;
}

interface TableParams {
  pagination: TablePaginationConfig;
  sortField?: string;
  sortOrder?: string;
  filters?: Record<string, FilterValue | null>;
}

interface DataType extends Post {
  key: string;
}

// Mock API service
const postApi = {
  getPosts: async (params: any) => {
    // This is a mock implementation
    console.log('Fetching posts with params:', params);
    return {
      data: [
        {
          id: '1',
          key: '1',
          title: 'Bài viết mẫu',
          slug: 'bai-viet-mau',
          content: 'Nội dung bài viết mẫu',
          status: POST_STATUS.PUBLISHED,
          views: 100,
          likes: 10,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
          published_at: new Date().toISOString(),
          author: {
            id: '1',
            full_name: 'Nguyễn Văn A',
            email: 'nguyenvana@example.com',
          },
          category: {
            id: '1',
            name: 'Công nghệ',
            slug: 'cong-nghe'
          },
          tags: [
            { id: '1', name: 'React' },
            { id: '2', name: 'Next.js' }
          ]
        }
      ],
      pagination: {
        current: params.page || 1,
        pageSize: params.pageSize || 10,
        total: 1
      }
    };
  },
  
  deletePost: async (id: string) => {
    console.log('Deleting post with id:', id);
    // This is a mock implementation
    return { success: true };
  }
};

// Main component
const PostManagementPage = () => {
  const router = useRouter();
  const [data, setData] = useState<DataType[]>([]);
  const [loading, setLoading] = useState(false);
  const [searchText, setSearchText] = useState('');
  const [statusFilter, setStatusFilter] = useState<PostStatus | undefined>(undefined);
  const [tableParams, setTableParams] = useState<TableParams>({
    pagination: {
      current: 1,
      pageSize: 10,
      total: 0,
      showSizeChanger: true,
      showQuickJumper: true,
      showTotal: (total, range) => `${range[0]}-${range[1]} trên ${total} bài viết`,
    },
  });

  const fetchData = useCallback(async () => {
    setLoading(true);
    try {
      const params = {
        page: tableParams.pagination?.current,
        pageSize: tableParams.pagination?.pageSize,
        search: searchText,
        status: statusFilter,
      };
      
      const response = await postApi.getPosts(params);
      setData(response.data);
      setTableParams({
        ...tableParams,
        pagination: {
          ...tableParams.pagination,
          total: response.pagination.total,
        },
      });
    } catch (error) {
      message.error('Có lỗi xảy ra khi tải dữ liệu');
      console.error('Error fetching posts:', error);
    } finally {
      setLoading(false);
    }
  }, [JSON.stringify(tableParams), searchText, statusFilter]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const handleDelete = useCallback(async (id: string) => {
    try {
      await postApi.deletePost(id);
      message.success('Xóa bài viết thành công');
      fetchData();
    } catch (error) {
      message.error('Có lỗi xảy ra khi xóa bài viết');
      console.error('Error deleting post:', error);
    }
  }, [fetchData]);

  const handleTableChange: TableProps<DataType>['onChange'] = (
    pagination: TablePaginationConfig,
    filters: Record<string, FilterValue | null>,
    sorter: SorterResult<DataType> | SorterResult<DataType>[],
    extra: any
  ) => {
    // Handle status filter
    if (filters.status) {
      setStatusFilter(filters.status[0] as PostStatus | undefined);
    } else {
      setStatusFilter(undefined);
    }

    setTableParams({
      pagination: {
        ...tableParams.pagination,
        ...pagination,
      },
      filters,
      ...sorter,
    });
  };

  const handleSearch = (value: string) => {
    setSearchText(value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1,
      },
    });
  };

  const handleStatusChange = (value: PostStatus | undefined) => {
    setStatusFilter(value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1,
      },
    });
  };

  // Define status map for consistent styling
  const statusMap = {
    [POST_STATUS.PUBLISHED]: { color: 'green', text: 'Đã xuất bản' },
    [POST_STATUS.DRAFT]: { color: 'orange', text: 'Bản nháp' },
    [POST_STATUS.PENDING]: { color: 'blue', text: 'Chờ duyệt' },
    [POST_STATUS.REJECTED]: { color: 'red', text: 'Từ chối' },
    [POST_STATUS.ARCHIVED]: { color: 'gray', text: 'Lưu trữ' },
  };

  // Define table columns inside the component to access router and handleDelete
  const columns: ColumnsType<DataType> = [
    {
      title: 'Tiêu đề',
      dataIndex: 'title',
      key: 'title',
      width: '30%',
      render: (text: string, record: DataType) => (
        <Link href={`/bai-viet/${record.slug}`} target="_blank" className="font-medium">
          {text}
        </Link>
      ),
    },
    {
      title: 'Tác giả',
      dataIndex: ['author', 'full_name'],
      key: 'author',
      width: '15%',
    },
    {
      title: 'Danh mục',
      dataIndex: ['category', 'name'],
      key: 'category',
      width: '15%',
    },
    {
      title: 'Trạng thái',
      dataIndex: 'status',
      key: 'status',
      width: '15%',
      filters: [
        { text: 'Đã xuất bản', value: POST_STATUS.PUBLISHED },
        { text: 'Bản nháp', value: POST_STATUS.DRAFT },
        { text: 'Chờ duyệt', value: POST_STATUS.PENDING },
        { text: 'Từ chối', value: POST_STATUS.REJECTED },
        { text: 'Lưu trữ', value: POST_STATUS.ARCHIVED },
      ],
      filteredValue: statusFilter ? [statusFilter] : undefined,
      render: (status: PostStatus) => {
        const statusInfo = statusMap[status] || { color: 'default', text: status };
        return (
          <Tag color={statusInfo.color}>
            {statusInfo.text}
          </Tag>
        );
      },
    },
    {
      title: 'Ngày tạo',
      dataIndex: 'created_at',
      key: 'created_at',
      width: '15%',
      sorter: (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
      render: (date: string) => new Date(date).toLocaleDateString('vi-VN'),
    },
    {
      title: 'Hành động',
      key: 'action',
      width: '15%',
      render: (_: any, record: DataType) => (
        <Space size="middle">
          <Button
            type="text"
            icon={<EyeOutlined />}
            onClick={() => router.push(`/admin/bai-viet/xem/${record.id}`)}
            title="Xem chi tiết"
          />
          <Button
            type="text"
            icon={<EditOutlined />}
            onClick={() => router.push(`/admin/bai-viet/chinh-sua/${record.id}`)}
            title="Chỉnh sửa"
          />
          <Popconfirm
            title="Bạn có chắc chắn muốn xóa?"
            onConfirm={() => handleDelete(record.id)}
            okText="Có"
            cancelText="Không"
            okButtonProps={{ danger: true }}
          >
            <Button 
              type="text" 
              danger 
              icon={<DeleteOutlined />} 
              title="Xóa"
            />
          </Popconfirm>
        </Space>
      ),
    },
  ];

  return (
    <div className="p-6">
      <Card
        title={
          <div className="flex justify-between items-center">
            <Title level={4} className="mb-0">
              Quản lý bài viết
            </Title>
            <Button
              type="primary"
              icon={<PlusOutlined />}
              onClick={() => router.push('/admin/bai-viet/them-moi')}
            >
              Thêm mới
            </Button>
          </div>
        }
        bordered={false}
        className="shadow-sm"
      >
        <div className="mb-6 flex flex-col sm:flex-row gap-4">
          <div className="flex-1">
            <Search
              placeholder="Tìm kiếm bài viết..."
              allowClear
              enterButton={
                <Button type="primary" icon={<SearchOutlined />}>
                  Tìm kiếm
                </Button>
              }
              onSearch={handleSearch}
              className="w-full sm:w-96"
              value={searchText}
              onChange={(e) => setSearchText(e.target.value)}
            />
          </div>
          <div className="w-full sm:w-48">
            <Select
              placeholder="Lọc theo trạng thái"
              allowClear
              onChange={handleStatusChange}
              className="w-full"
              value={statusFilter}
            >
              {Object.entries(statusMap).map(([value, { text }]) => (
                <Option key={value} value={value}>
                  {text}
                </Option>
              ))}
            </Select>
          </div>
        </div>

        <Table
          columns={columns}
          rowKey="id"
          dataSource={data}
          pagination={{
            ...tableParams.pagination,
            showSizeChanger: true,
            showQuickJumper: true,
            showTotal: (total, range) => 
              `${range[0]}-${range[1]} của ${total} bài viết`,
          }}
          loading={loading}
          onChange={handleTableChange}
          scroll={{ x: '100%' }}
          className="ant-table-striped"
          rowClassName={(_, index) => (index % 2 === 0 ? 'table-row-light' : 'table-row-dark')}
        />
      </Card>
  slug: string;
  author: {
    full_name: string;
  };
  category: {
    name: string;
  };
  status: POST_STATUS;
  created_at: string;
}

interface TableParams {
  pagination: TablePaginationConfig;
  sortField?: string;
  sortOrder?: string;
  filters?: Record<string, FilterValue | null>;
}

interface DataType extends Post {
  key: string;
}

// Mock API service
const postApi = {
  getPosts: async (params: any) => {
    // This is a mock implementation
    return {
      data: [],
      pagination: {
        current: 1,
        pageSize: 10,
        total: 0
      }
    };
  },
  deletePost: async (id: string) => {
    // This is a mock implementation
    return { success: true };
  }
};

// Main component
export default function PostList() {
  const router = useRouter();
  const [data, setData] = useState<DataType[]>([]);
  const [loading, setLoading] = useState(false);
  const [searchText, setSearchText] = useState('');
  const [statusFilter, setStatusFilter] = useState<POST_STATUS | undefined>(undefined);
  const [tableParams, setTableParams] = useState<TableParams>({
    pagination: {
      current: 1,
      pageSize: 10,
    },
  });

  // Define table columns inside the component to access router and handleDelete
  const columns: ColumnsType<DataType> = [
    {
      title: 'Tiêu đề',
      dataIndex: 'title',
      key: 'title',
      render: (text: string, record: DataType) => (
        <Link href={`/bai-viet/${record.slug}`}>{text}</Link>
      ),
    },
    {
      title: 'Tác giả',
      dataIndex: ['author', 'full_name'],
      key: 'author',
    },
    {
      title: 'Danh mục',
      dataIndex: ['category', 'name'],
      key: 'category',
    },
    {
      title: 'Trạng thái',
      dataIndex: 'status',
      key: 'status',
      render: (status: PostStatus) => {
        let color: string = 'default';
        if (status === POST_STATUS.PUBLISHED) {
          color = 'success';
        } else if (status === POST_STATUS.DRAFT) {
          color = 'processing';
        }
        return <Tag color={color}>{status}</Tag>;
      },
      filters: [
        { text: 'Bản nháp', value: POST_STATUS.DRAFT },
        { text: 'Đã xuất bản', value: POST_STATUS.PUBLISHED },
        { text: 'Lưu trữ', value: POST_STATUS.ARCHIVED },
      ],
      filteredValue: statusFilter ? [statusFilter] : [],
    },
    {
      title: 'Ngày tạo',
      dataIndex: 'created_at',
      key: 'created_at',
      render: (date: string) => new Date(date).toLocaleDateString(),
    },
    {
      title: 'Hành động',
      key: 'action',
      render: (_: any, record: DataType) => (
        <Space size="middle">
          <Button
            type="text"
            icon={<EyeOutlined />}
            onClick={() => router.push(`/admin/bai-viet/xem/${record.id}`)}
          />
          <Button
            type="text"
            icon={<EditOutlined />}
            onClick={() => router.push(`/admin/bai-viet/chinh-sua/${record.id}`)}
          />
          <Popconfirm
            title="Bạn có chắc chắn muốn xóa?"
            onConfirm={() => handleDelete(record.id)}
            okText="Có"
            cancelText="Không"
          >
            <Button type="text" danger icon={<DeleteOutlined />} />
          </Popconfirm>
        </Space>
      ),
    },
  ];

  const fetchData = async () => {
    setLoading(true);
    try {
      const params = {
        page: tableParams.pagination?.current,
        pageSize: tableParams.pagination?.pageSize,
        search: searchText,
        status: statusFilter,
      };
      
      const response = await postApi.getPosts(params);
      setData(response.data);
      setTableParams({
        ...tableParams,
        pagination: {
          ...tableParams.pagination,
          total: response.pagination.total,
        },
      });
    } catch (error) {
      message.error('Có lỗi xảy ra khi tải dữ liệu');
      console.error(error);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, [JSON.stringify(tableParams), searchText, statusFilter]);

  const handleTableChange: TableProps<DataType>['onChange'] = (
    pagination: TablePaginationConfig,
    filters: Record<string, FilterValue | null>,
    sorter: SorterResult<DataType> | SorterResult<DataType>[],
    extra: any
  ) => {
    // Handle status filter
    if (filters.status) {
      setStatusFilter(filters.status[0] as PostStatus | undefined);
    } else {
      setStatusFilter(undefined);
    }

    setTableParams({
      pagination,
      filters,
      ...sorter,
    });
  };

  const handleSearch = (value: string) => {
    setSearchText(value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1,
      },
    });
  };

  const handleStatusChange = (value: PostStatus | undefined) => {
    setStatusFilter(value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1,
      },
    });
  };

  const handleDelete = async (id: string) => {
    try {
      await postApi.deletePost(id);
      message.success('Xóa bài viết thành công');
      fetchData();
    } catch (error) {
      message.error('Có lỗi xảy ra khi xóa bài viết');
      console.error(error);
    }
  };

  return (
    <div className="p-4">
      <Card
        title={
          <div className="flex justify-between items-center">
            <Typography.Title level={4} className="mb-0">
              Quản lý bài viết
            </Typography.Title>
            <Button
              type="primary"
              icon={<PlusOutlined />}
              onClick={() => router.push('/admin/bai-viet/them-moi')}
            >
              Thêm mới
            </Button>
          </div>
        }
      >
        <div className="mb-4 flex gap-4">
          <Input.Search
            placeholder="Tìm kiếm bài viết..."
            allowClear
            enterButton={
              <Button type="primary" icon={<SearchOutlined />} />
            }
            onSearch={handleSearch}
            className="w-64"
          />
          <Select
            placeholder="Lọc theo trạng thái"
            allowClear
            onChange={handleStatusChange}
            className="w-48"
            value={statusFilter}
          >
            <Select.Option value={POST_STATUS.DRAFT}>Bản nháp</Select.Option>
            <Select.Option value={POST_STATUS.PUBLISHED}>Đã xuất bản</Select.Option>
            <Select.Option value={POST_STATUS.ARCHIVED}>Lưu trữ</Select.Option>
          </Select>
        </div>

        <Table
          columns={columns}
          rowKey="id"
          dataSource={data}
          pagination={tableParams.pagination}
          loading={loading}
          onChange={handleTableChange}
          scroll={{ x: true }}
        />
      </Card>
    </div>
  );
}

const PostManagementPage: React.FC = () => {
  const router = useRouter();
  const [loading, setLoading] = useState<boolean>(false);
  const [tableParams, setTableParams] = useState<TableParams>({
    pagination: {
      current: 1,
      pageSize: 10,
    },
  });
  const [searchText, setSearchText] = useState<string>('');
  const [statusFilter, setStatusFilter] = useState<string | undefined>(undefined);
  const [data, setData] = useState<DataType[]>([]);
  const [total, setTotal] = useState<number>(0);

  // Lấy danh sách bài viết
  const fetchPosts = useCallback(async (params: TableParams = tableParams) => {
    try {
      setLoading(true);
      const { current: page, pageSize } = params.pagination || { current: 1, pageSize: 10 };
      
      const response = await postApi.getPosts({
        page,
        limit: pageSize,
        status: statusFilter,
        search: searchText,
      });

      const formattedData = response.data.map((post: Post) => ({
        ...post,
        key: post.id,
        author_name: post.author?.full_name || 'N/A',
        category_name: post.category?.name || 'N/A',
      }));

      setData(formattedData);
      setTotal(response.pagination?.total || 0);
      
      setTableParams({
        ...params,
        pagination: {
          ...params.pagination,
          total: response.pagination?.total || 0,
        },
      });
    } catch (error) {
      message.error('Có lỗi xảy ra khi tải danh sách bài viết');
      console.error('Error fetching posts:', error);
    } finally {
      setLoading(false);
    }
  }, [searchText, statusFilter, tableParams]);

  // Xử lý phân trang, sắp xếp, lọc
  const handleTableChange: TableProps<DataType>['onChange'] = (
    pagination,
    filters,
    sorter,
  ) => {
    setTableParams({
      pagination: {
        ...pagination,
        current: pagination.current || 1,
        pageSize: pagination.pageSize || 10,
      },
      filters,
      ...sorter,
    });

    // Cập nhật trạng thái lọc nếu có thay đổi
    if (filters.status) {
      setStatusFilter(filters.status[0] as string);
    } else {
      setStatusFilter(undefined);
    }
  };

  // Xóa bài viết
  const handleDelete = async (id: string) => {
    try {
      await postApi.deletePost(id);
      message.success('Xóa bài viết thành công');
      fetchPosts(tableParams);
    } catch (error) {
      message.error('Có lỗi xảy ra khi xóa bài viết');
      console.error('Error deleting post:', error);
    }
  };

  // Tìm kiếm
  const handleSearch = (value: string) => {
    setSearchText(value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1, // Reset về trang đầu tiên khi tìm kiếm
      },
    });
  };

  // Lọc theo trạng thái
  const handleStatusChange = (value: string) => {
    setStatusFilter(value === 'all' ? undefined : value);
    setTableParams({
      ...tableParams,
      pagination: {
        ...tableParams.pagination,
        current: 1, // Reset về trang đầu tiên khi lọc
      },
    });
  };

  // Load dữ liệu ban đầu
  useEffect(() => {
    fetchPosts(tableParams);
  }, [fetchPosts, tableParams]);

  // Cột của bảng
  const columns: ColumnsType<DataType> = [
    {
      title: 'Tiêu đề',
      dataIndex: 'title',
      key: 'title',
      width: '25%',
      render: (text: string, record: DataType) => (
        <Link href={`/bai-viet/${record.slug}`} target="_blank" className="text-blue-500 hover:underline">
          {text}
        </Link>
      ),
    },
    {
      title: 'Tác giả',
      dataIndex: 'author_name',
      key: 'author',
      width: '15%',
    },
    {
      title: 'Danh mục',
      dataIndex: 'category_name',
      key: 'category',
      width: '15%',
    },
    {
      title: 'Trạng thái',
      dataIndex: 'status',
      key: 'status',
      width: '15%',
      render: (status: PostStatus) => {
        let color = 'default';
        let text = 'Không xác định';
        
        switch (status) {
          case PostStatus.PUBLISHED:
            color = 'success';
            text = 'Đã xuất bản';
            break;
          case PostStatus.DRAFT:
            color = 'default';
            text = 'Bản nháp';
            break;
          case PostStatus.PENDING:
            color = 'processing';
            text = 'Chờ duyệt';
            break;
          case PostStatus.REJECTED:
            color = 'error';
            text = 'Từ chối';
            break;
          default:
            break;
        }
        
        return <Tag color={color}>{text}</Tag>;
      },
    },
    {
      title: 'Ngày tạo',
      dataIndex: 'created_at',
      key: 'created_at',
      width: '15%',
      render: (date: string) => new Date(date).toLocaleDateString('vi-VN') + ' ' + new Date(date).toLocaleTimeString('vi-VN'),
    },
    {
      title: 'Hành động',
      key: 'action',
      width: '15%',
      render: (_: any, record: DataType) => (
        <Space size="middle">
          <Button
            type="text"
            icon={<EyeOutlined />}
            onClick={() => router.push(`/bai-viet/${record.slug}`)}
            title="Xem chi tiết"
          />
          <Button
            type="text"
            icon={<EditOutlined />}
            onClick={() => router.push(`/admin/bai-viet/chinh-sua/${record.id}`)}
            title="Chỉnh sửa"
          />
          <Popconfirm
            title="Bạn có chắc chắn muốn xóa bài viết này?"
            onConfirm={() => handleDelete(record.id)}
            okText="Có"
            cancelText="Không"
            okButtonProps={{ danger: true }}
          >
            <Button
              type="text"
              icon={<DeleteOutlined />}
              danger
              title="Xóa"
            />
          </Popconfirm>
        </Space>
      ),
    },
  ];

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold">Quản lý bài viết</h1>
        <Button
          type="primary"
          icon={<PlusOutlined />}
          onClick={() => router.push('/admin/bai-viet/them-moi')}
        >
          Thêm bài viết
        </Button>
      </div>

      <Card>
        <div className="flex gap-4 mb-6">
          <Search
            placeholder="Tìm kiếm bài viết..."
            allowClear
            enterButton={<SearchOutlined />}
            onSearch={handleSearch}
            className="w-64"
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
          />
          <Select
            placeholder="Lọc theo trạng thái"
            allowClear
            onChange={handleStatusChange}
            className="w-48"
            value={statusFilter}
          >
            <Option value="all">Tất cả</Option>
            <Option value={PostStatus.PUBLISHED}>Đã xuất bản</Option>
            <Option value={PostStatus.DRAFT}>Bản nháp</Option>
            <Option value={PostStatus.PENDING}>Chờ duyệt</Option>
            <Option value={PostStatus.REJECTED}>Từ chối</Option>
          </Select>
        </div>

        <Table
          columns={columns}
          dataSource={data}
          rowKey="id"
          loading={loading}
          pagination={{
            ...tableParams.pagination,
            total: total,
            showSizeChanger: true,
            pageSizeOptions: ['10', '20', '50'],
            showTotal: (total, range) => `${range[0]}-${range[1]} trong ${total} bài viết`,
          }}
          onChange={handleTableChange}
          scroll={{ x: '100%' }}
        />
      </Card>
    </div>
  );
};
        const statusMap = {
          [PostStatus.PUBLISHED]: { color: 'success', text: 'Đã xuất bản' },
          [PostStatus.DRAFT]: { color: 'processing', text: 'Bản nháp' },
          [PostStatus.PENDING]: { color: 'warning', text: 'Chờ duyệt' },
          [PostStatus.REJECTED]: { color: 'error', text: 'Từ chối' },
        };
        return <Tag color={statusMap[status]?.color || 'default'}>{statusMap[status]?.text || status}</Tag>;
      },
      filters: [
        { text: 'Tất cả', value: 'all' },
        { text: 'Đã xuất bản', value: PostStatus.PUBLISHED },
        { text: 'Bản nháp', value: PostStatus.DRAFT },
        { text: 'Chờ duyệt', value: PostStatus.PENDING },
        { text: 'Từ chối', value: PostStatus.REJECTED },
      ],
      filteredValue: statusFilter ? [statusFilter] : undefined,
    },
    {
      title: 'Ngày tạo',
      dataIndex: 'created_at',
      key: 'created_at',
      width: '15%',
      render: (date: string) => new Date(date).toLocaleDateString('vi-VN') + ' ' + new Date(date).toLocaleTimeString('vi-VN'),
    },
    {
      title: 'Hành động',
      key: 'action',
      width: '15%',
      render: (_: any, record: DataType) => (
        <Space size="middle">
          <Button
            type="text"
            icon={<EyeOutlined />}
            onClick={() => router.push(`/bai-viet/${record.slug}`)}
            title="Xem chi tiết"
          />
          <Button
            type="text"
            icon={<EditOutlined />}
            onClick={() => router.push(`/admin/bai-viet/chinh-sua/${record.id}`)}
            title="Chỉnh sửa"
          />
          <Popconfirm
            title="Bạn có chắc chắn muốn xóa bài viết này?"
            onConfirm={() => handleDelete(record.id)}
            okText="Có"
            cancelText="Không"
            okButtonProps={{ danger: true }}
          >
            <Button
              type="text"
              icon={<DeleteOutlined />}
              danger
              title="Xóa"
            />
          </Popconfirm>
        </Space>
      ),
    },
  ];

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold">Quản lý bài viết</h1>
        <Button
          type="primary"
          icon={<PlusOutlined />}
          onClick={() => router.push('/admin/bai-viet/them-moi')}
        >
          Thêm bài viết
        </Button>
      </div>

      <Card>
        <div className="flex gap-4 mb-6">
          <Search
            placeholder="Tìm kiếm bài viết..."
            allowClear
            enterButton={<SearchOutlined />}
            onSearch={handleSearch}
            className="w-64"
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
          />
          <Select
            placeholder="Lọc theo trạng thái"
            allowClear
            onChange={handleStatusChange}
            className="w-48"
            value={statusFilter}
          >
            <Option value="all">Tất cả</Option>
            <Option value={PostStatus.PUBLISHED}>Đã xuất bản</Option>
            <Option value={PostStatus.DRAFT}>Bản nháp</Option>
            <Option value={PostStatus.PENDING}>Chờ duyệt</Option>
            <Option value={PostStatus.REJECTED}>Từ chối</Option>
          </Select>
        </div>

        <Table
          columns={columns}
          dataSource={data}
          rowKey="id"
          loading={loading}
          pagination={{
            ...tableParams.pagination,
            total: total,
            showSizeChanger: true,
            pageSizeOptions: ['10', '20', '50'],
            showTotal: (total, range) => `${range[0]}-${range[1]} trong ${total} bài viết`,
          }}
          onChange={handleTableChange}
          scroll={{ x: '100%' }}
          <Option value={PostStatus.PUBLISHED}>Đã xuất bản</Option>
          <Option value={PostStatus.DRAFT}>Bản nháp</Option>
          <Option value={PostStatus.PENDING}>Chờ duyệt</Option>
          <Option value={PostStatus.REJECTED}>Từ chối</Option>
        </Select>
      </div>

      <Table
        columns={columns}
        dataSource={data}
        rowKey="id"
        loading={loading}
        pagination={{
          ...tableParams.pagination,
          total: total,
          showSizeChanger: true,
          pageSizeOptions: ['10', '20', '50'],
          showTotal: (total, range) => `${range[0]}-${range[1]} trong ${total} bài viết`,
        }}
        onChange={handleTableChange}
        scroll={{ x: '100%' }}
      />
    </Card>
  </div>
);
}

export default PostManagementPage;
