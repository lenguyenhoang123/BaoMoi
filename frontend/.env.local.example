# Environment variables for local development
# Copy this file to .env.local and update the values as needed

# Application Environment
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3004
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Database (example, update with your actual database configuration)
DATABASE_URL=postgresql://user:password@localhost:5432/baomoi?schema=public

# OAuth Providers (example, update with your actual credentials)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_MAINTENANCE_MODE=false

# Logging
LOG_LEVEL=debug

# CORS Configuration
ENABLE_CORS=true

# Image Optimization
NEXT_IMAGE_ALLOWED_DOMAINS=via.placeholder.com,cdn2.tuoitre.vn,images.unsplash.com,example.com

# API Rate Limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
NEXT_PUBLIC_USE_HTTPS=false
NEXT_PUBLIC_HSTS_ENABLED=false
NEXT_PUBLIC_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:;"

# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Other Services
# STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
