# Cấu hình cơ sở dữ liệu
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baomoi
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30d

# Cổng dịch vụ
AUTH_SERVICE_PORT=3001
POSTS_SERVICE_PORT=3002
CATEGORIES_SERVICE_PORT=3003
COMMENTS_SERVICE_PORT=3004
API_GATEWAY_PORT=3000
FRONTEND_PORT=3005

# Chế độ phát triển
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3005

# Tùy chọn Sequelize
DB_LOGGING=false

# Tùy chọn Redis (nếu có sử dụng)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Tùy chọn upload file
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=5MB
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
